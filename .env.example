# ============================================================================
# Vigil — Switch Incident-to-Hotfix War Room Configuration
# ============================================================================

# Mode:
# - Leave SWITCH_SERVER_URL empty to boot Vigil with its built-in Spec-Exact
#   Switch WebSocket Agent Protocol Server (zero external setup required!).
# - Set SWITCH_SERVER_URL to your live Switch Server (from Switch Console)
#   to connect Vigil's WebSocket agents directly into Mattermost, Discord,
#   Telegram, or Slack rooms!
SWITCH_SERVER_URL=
SWITCH_REGISTRATION_KEY=

# Team prefix used when provisioning templates/vigil-war-room.template.yaml
VIGIL_TEAM=vigil

# Ports
VIGIL_PORT=4010
CHECKOUT_API_PORT=4020

# Optional pre-registered Switch Agent credentials (auto-populated by `npm run onboard:switch`)
VIGIL_SENTINEL_AGENT_ID=
VIGIL_SENTINEL_API_KEY=
VIGIL_PATCHER_AGENT_ID=
VIGIL_PATCHER_API_KEY=
VIGIL_RELEASE_GATE_AGENT_ID=
VIGIL_RELEASE_GATE_API_KEY=

# Optional external Switch Coding Agent name in #vigil-hotfix (e.g., Claude Code or Antigravity
# onboarded via Switch Console). When set, vigil-sentinel also @mentions this agent in #vigil-hotfix.
SWITCH_CONSOLE_CODER_HANDLE=

# Who writes the hotfix: `auto` = Vigil's own patcher stages the reference fix; `external` = a coding
# agent you already use (Claude Code / Codex / Antigravity) bound through Switch Console authors it and
# vigil-patcher only verifies. Defaults to `external` when SWITCH_CONSOLE_CODER_HANDLE is set.
# Can also be flipped at runtime from the War Room or `POST /api/patch-mode`.
VIGIL_PATCH_MODE=

# Synthetic traffic against the live checkout-api (ms between requests; 0 disables). Error rate and p99
# in the War Room are measured from this real request stream plus probes.
CHECKOUT_TRAFFIC_INTERVAL_MS=250

# ---------------------------------------------------------------------------
# The service Vigil guards
# ---------------------------------------------------------------------------
# Target manifest (default targets/checkout-api.target.json, the demo service). See targets/README.md.
VIGIL_TARGET=

# ---------------------------------------------------------------------------
# Public deployment (Mode B)
# ---------------------------------------------------------------------------
# The chat app's team URL; the War Room links each room to <url>/channels/<room>, where people approve.
VIGIL_CHAT_URL=
# Operator key: with it set, visitors can watch, ship one chaos release at a time and run the rogue-agent
# test; every other control needs `Authorization: Bearer <key>`. Requests made on the host itself count as
# the operator. Unset: everything is open (local use).
VIGIL_OPERATOR_KEY=
# Keep incidents and the policy audit in this JSON file across restarts.
VIGIL_LEDGER_FILE=

# ---------------------------------------------------------------------------
# Alerts from monitoring tools: POST /api/webhooks/{alertmanager,sentry,generic}
# ---------------------------------------------------------------------------
# Token as `Authorization: Bearer <token>` or `?token=`. Once set, it is required.
VIGIL_ALERT_TOKEN=
# Sentry's client secret: Sentry may sign instead of sending the token.
VIGIL_SENTRY_CLIENT_SECRET=
# `off`: the service does not raise its own alert, so your monitoring tool is the trigger.
VIGIL_SELF_ALERTS=on

# ---------------------------------------------------------------------------
# Running candidate code safely on a shared host (Linux, Vigil running as root)
# ---------------------------------------------------------------------------
# Run the service, its tests and the staging copy as this unprivileged user.
VIGIL_SERVICE_USER=
# Make the live working copy group-writable for an external coder's own user (scripts/setup-coder-user.sh).
VIGIL_SHARED_GROUP=
