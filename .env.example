# ============================================================================
# Vigil — Switch Incident-to-Hotfix War Room Configuration
# ============================================================================

# Mode:
# - Leave SWITCH_SERVER_URL empty to boot Vigil with its built-in Spec-Exact
#   Switch WebSocket Agent Protocol Server (zero external setup required!).
# - Set SWITCH_SERVER_URL to your live Switch Server (from Switch Console)
#   to connect Vigil's WebSocket agents directly into Mattermost, Discord,
#   Telegram, or Slack rooms!
SWITCH_SERVER_URL=
SWITCH_REGISTRATION_KEY=

# Team prefix used when provisioning templates/vigil-war-room.template.yaml
VIGIL_TEAM=vigil

# Ports
VIGIL_PORT=4010
CHECKOUT_API_PORT=4020

# Optional pre-registered Switch Agent credentials (auto-populated by `npm run onboard:switch`)
VIGIL_SENTINEL_AGENT_ID=
VIGIL_SENTINEL_API_KEY=
VIGIL_PATCHER_AGENT_ID=
VIGIL_PATCHER_API_KEY=
VIGIL_RELEASE_GATE_AGENT_ID=
VIGIL_RELEASE_GATE_API_KEY=

# Optional external Switch Coding Agent name in #vigil-hotfix (e.g., Claude Code or Antigravity
# onboarded via Switch Console). When set, vigil-sentinel also @mentions this agent in #vigil-hotfix!
SWITCH_CONSOLE_CODER_HANDLE=

# Who writes the hotfix: `auto` = Vigil's own patcher stages the reference fix; `external` = a coding
# agent you already use (Claude Code / Codex / Antigravity) bound through Switch Console authors it and
# vigil-patcher only verifies. Defaults to `external` when SWITCH_CONSOLE_CODER_HANDLE is set.
# Can also be flipped at runtime from the Observatory or `POST /api/patch-mode`.
VIGIL_PATCH_MODE=
